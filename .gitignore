/node_modules
/.next
/out
/build
/coverage
voice-agent/.venv
**/__pycache__/
*.pyc
*.tsbuildinfo
.git_corrupt_backup/

# Logs and OS noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
