# Agent-only overrides. Loaded before ../.env.local, so anything set here wins.

# How fast Priya talks. sonic-3 takes 0.6-2.0; 1.0 is the voice's natural pace.
# 0.85 drew a "why do you speak so slowly?" on a test call; 1.0 felt a touch fast.
VOICE_SPEED=0.90

# How long the voice detector waits before telling the recognizer to finish and letting
# Gemini start on what it has heard. The head start Gemini gets is
# (VOICE_END_OF_TURN_SECS - VOICE_SILENCE_SECS); at 0.12 that was 0.18s, too short to send
# the request at all, so median_hidden_secs measured 0.003. At 0.05 the head start is 0.25s,
# enough for most of Gemini's ~0.40s to run inside the end-of-turn wait we pay for anyway.
VOICE_SILENCE_SECS=0.05
VOICE_END_OF_TURN_SECS=0.3

# Telugu script gave clearer pronunciation but TTS start went 0.11s -> 0.63-1.39s
# (replies hit 1.7-3.0s), so back to English letters.
VOICE_SCRIPT=latin
